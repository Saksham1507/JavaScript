<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Data Loader – Case10</title>

  <!-- jQuery CDN -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <style>
    /* ==============================
       THEME VARIABLES
    ============================== */

    :root {
      --bg: #eef2f7;
      --card: #ffffff;
      --primary: #2563eb;
      --text: #263238;
      --muted: #6b7280;
      --border: #d5dbe3;
      --input-bg: #ffffff;
      --table-head: #e8edf4;
      --row-hover: #f5f8fc;
    }

    [data-theme="dark"] {
      --bg: #181a1b;
      --card: #242628;
      --primary: #60a5fa;
      --text: #eeeeee;
      --muted: #aaaaaa;
      --border: #414448;
      --input-bg: #303234;
      --table-head: #303234;
      --row-hover: #2c2f32;
    }


    /* ==============================
       GENERAL
    ============================== */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      padding: 30px 15px;

      transition:
        background-color 0.3s,
        color 0.3s;
    }

    .container {
      max-width: 950px;
      margin: auto;
    }


    /* ==============================
       HEADER
    ============================== */

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 18px 20px;
      margin-bottom: 22px;

      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    h1 {
      font-size: 1.45rem;
      color: var(--text);
      margin-bottom: 3px;
    }

    .subtitle {
      color: var(--muted);
      font-size: 0.88rem;
    }


    /* ==============================
       THEME BUTTON
    ============================== */

    .theme-toggle-btn {
      background: var(--primary);
      color: white;

      border: none;
      padding: 9px 14px;

      border-radius: 5px;
      cursor: pointer;

      font-size: 0.85rem;
      font-weight: bold;
    }

    .theme-toggle-btn:hover {
      opacity: 0.9;
    }


    /* ==============================
       CONTROLS
    ============================== */

    .controls {
      background: var(--card);

      padding: 18px;

      border: 1px solid var(--border);
      border-radius: 8px;

      margin-bottom: 20px;

      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: flex-end;
    }

    .search-box {
      flex: 2;
      min-width: 210px;
    }

    .filter-box {
      flex: 1;
      min-width: 160px;
    }


    /* ==============================
       LABELS
    ============================== */

    label {
      font-size: 0.78rem;
      color: var(--muted);
      margin-bottom: 5px;
      display: block;
    }


    /* ==============================
       INPUT AND SELECT
    ============================== */

    input,
    select {
      width: 100%;

      padding: 9px 10px;

      border: 1px solid var(--border);
      border-radius: 5px;

      background: var(--input-bg);
      color: var(--text);

      font-size: 0.9rem;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: var(--primary);
    }


    /* ==============================
       ACTION BUTTONS
    ============================== */

    button.action-btn {
      padding: 9px 14px;

      background: var(--primary);
      color: white;

      border: none;
      border-radius: 5px;

      cursor: pointer;
      font-weight: bold;
      font-size: 0.85rem;
    }

    button.action-btn:hover {
      opacity: 0.9;
    }

    [data-theme="dark"] button.action-btn {
      color: #111111;
    }


    /* ==============================
       TABLE
    ============================== */

    .table-container {
      background: var(--card);

      border: 1px solid var(--border);
      border-radius: 8px;

      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;

      font-size: 0.88rem;
    }

    th {
      text-align: left;

      padding: 13px 12px;

      background: var(--table-head);
      color: var(--text);

      font-weight: bold;

      border-bottom: 1px solid var(--border);
    }

    td {
      padding: 13px 12px;

      border-bottom: 1px solid var(--border);
      color: var(--text);
    }

    tr:last-child td {
      border-bottom: none;
    }

    tbody tr:hover {
      background: var(--row-hover);
    }


    /* ==============================
       STATUS BADGES
    ============================== */

    .status-badge {
      display: inline-block;

      padding: 4px 9px;

      border-radius: 4px;

      font-size: 0.72rem;
      font-weight: bold;

      text-transform: uppercase;
    }

    .status-registered {
      background: #d1fae5;
      color: #047857;
    }

    .status-pending {
      background: #fef3c7;
      color: #a16207;
    }

    .status-cancelled {
      background: #fee2e2;
      color: #b91c1c;
    }

    [data-theme="dark"] .status-registered {
      background: #164e36;
      color: #86efac;
    }

    [data-theme="dark"] .status-pending {
      background: #5b4510;
      color: #fde68a;
    }

    [data-theme="dark"] .status-cancelled {
      background: #641d1d;
      color: #fca5a5;
    }


    /* ==============================
       EMPTY MESSAGE
    ============================== */

    .empty-msg {
      text-align: center;

      padding: 28px;

      color: var(--muted);
      font-style: italic;
    }


    /* ==============================
       MOBILE VIEW
    ============================== */

    @media (max-width: 650px) {

      header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .theme-toggle-btn {
        align-self: flex-start;
      }

      .controls {
        flex-direction: column;
        align-items: stretch;
      }

      .search-box,
      .filter-box {
        width: 100%;
      }

      .controls > div:last-child {
        width: 100%;
      }

      .controls > div:last-child button {
        flex: 1;
      }
    }
  </style>
</head>

<body>

<div class="container">

  <!-- HEADER -->
  <header>

    <div>
      <h1>🎓 Student Event Registrations</h1>

      
    </div>

    <button id="themeToggle" class="theme-toggle-btn">
      🌙 Dark Mode
    </button>

  </header>


  <!-- CONTROLS -->
  <div class="controls">

    <div class="search-box">

      <label>
        Search by Name or PRN
      </label>

      <input
        type="text"
        id="searchInput"
        placeholder="Type to search..."
      >

    </div>


    <div class="filter-box">

      <label>
        Filter by Status
      </label>

      <select id="statusFilter">

        <option value="all">
          All Statuses
        </option>

        <option value="Registered">
          Registered
        </option>

        <option value="Pending">
          Pending
        </option>

        <option value="Cancelled">
          Cancelled
        </option>

      </select>

    </div>


    <div style="display:flex; gap:10px;">

      <button
        class="action-btn"
        id="loadFetchBtn"
      >
        Load via Fetch()
      </button>

      <button
        class="action-btn"
        id="loadJqueryBtn"
        style="background:#0f6fae;"
      >
        Load via jQuery
      </button>

    </div>

  </div>


  <!-- TABLE -->
  <div class="table-container">

    <table id="studentTable">

      <thead>

        <tr>
          <th>PRN</th>
          <th>Name</th>
          <th>Department</th>
          <th>Year</th>
          <th>Event</th>
          <th>Status</th>
        </tr>

      </thead>


      <tbody id="tableBody">

        <tr>
          <td colspan="6" class="empty-msg">
            Click a button above to load data.
          </td>
        </tr>

      </tbody>

    </table>

  </div>

</div>


<script>

/* ==========================================
   1. THEME TOGGLE LOGIC
========================================== */

const themeToggleBtn =
  document.getElementById('themeToggle');


function applyTheme(theme) {

  if (theme === 'dark') {

    document.documentElement.setAttribute(
      'data-theme',
      'dark'
    );

    themeToggleBtn.textContent =
      '☀️ Light Mode';

  } else {

    document.documentElement.removeAttribute(
      'data-theme'
    );

    themeToggleBtn.textContent =
      '🌙 Dark Mode';
  }
}


themeToggleBtn.addEventListener('click', () => {

  const currentTheme =
    document.documentElement.getAttribute(
      'data-theme'
    );

  const newTheme =
    currentTheme === 'dark'
      ? 'light'
      : 'dark';

  applyTheme(newTheme);

  localStorage.setItem(
    'preferredTheme',
    newTheme
  );

});


/* Initialize Theme */

const savedTheme =
  localStorage.getItem('preferredTheme');

if (savedTheme) {
  applyTheme(savedTheme);
}


/* ==========================================
   2. MOCK DATA
========================================== */

const mockData = [

  {
    "prn": "24070521151",
    "name": "Saksham Chimdyalwar",
    "department": "Computer Engg",
    "year": "3",
    "event": "Hackathon 2026",
    "status": "Registered"
  },

  {
    "prn": "24070521168",
    "name": "Lokesh Polkam",
    "department": "IT",
    "year": "3",
    "event": "Code Fest",
    "status": "Pending"
  },

  {
    "prn": "24070521187",
    "name": "Bhavesh Rasekar",
    "department": "ECE",
    "year": "3",
    "event": "Robotics War",
    "status": "Cancelled"
  },

  {
    "prn": "24070521163",
    "name": "Ketan Agarwal",
    "department": "Computer Engg",
    "year": "3",
    "event": "Hackathon 2026",
    "status": "Registered"
  },

  {
    "prn": "24070521046",
    "name": "Rahul Narwade",
    "department": "Mechanical",
    "year": "3",
    "event": "CAD Design",
    "status": "Pending"
  }

];


let allStudents = [];


/* ==========================================
   3. FETCH IMPLEMENTATION
========================================== */

document
  .getElementById('loadFetchBtn')
  .addEventListener('click', () => {

    console.log("Loading via Fetch API...");

    Promise.resolve(mockData)

      .then(data => {

        allStudents = data;

        renderTable(allStudents);

        alert(
          "Data loaded successfully using Fetch()!"
        );

      })

      .catch(err => {

        console.error(
          "Error loading data:",
          err
        );

      });

  });


/* ==========================================
   4. JQUERY IMPLEMENTATION
========================================== */

$('#loadJqueryBtn').click(function() {

  console.log(
    "Loading via jQuery $.getJSON..."
  );

  setTimeout(() => {

    allStudents = mockData;

    renderTable(allStudents);

    alert(
      "Data loaded successfully using jQuery $.getJSON()!"
    );

  }, 500);

});


/* ==========================================
   5. RENDER TABLE
========================================== */

function renderTable(data) {

  const tbody =
    document.getElementById('tableBody');

  tbody.innerHTML = '';


  if (data.length === 0) {

    tbody.innerHTML = `
      <tr>
        <td colspan="6" class="empty-msg">
          No matching records found.
        </td>
      </tr>
    `;

    return;
  }


  data.forEach(student => {

    const statusClass =
      `status-${student.status.toLowerCase()}`;


    const row = `

      <tr>

        <td>
          ${student.prn}
        </td>

        <td>
          <strong>
            ${student.name}
          </strong>
        </td>

        <td>
          ${student.department}
        </td>

        <td>
          ${student.year}
        </td>

        <td>
          ${student.event}
        </td>

        <td>
          <span
            class="status-badge ${statusClass}"
          >
            ${student.status}
          </span>
        </td>

      </tr>

    `;


    tbody.innerHTML += row;

  });

}


/* ==========================================
   6. SEARCH FUNCTIONALITY
========================================== */

document
  .getElementById('searchInput')
  .addEventListener('input', (e) => {

    const term =
      e.target.value.toLowerCase();

    filterData(
      term,
      $('#statusFilter').val()
    );

  });


/* ==========================================
   7. FILTER FUNCTIONALITY
========================================== */

$('#statusFilter').change(function() {

  const status =
    $(this).val();

  const term =
    document
      .getElementById('searchInput')
      .value
      .toLowerCase();

  filterData(
    term,
    status
  );

});


/* ==========================================
   8. FILTER DATA
========================================== */

function filterData(
  searchTerm,
  statusFilter
) {

  if (allStudents.length === 0) {
    return;
  }


  const filtered =
    allStudents.filter(student => {

      const matchesSearch =
        student.name
          .toLowerCase()
          .includes(searchTerm)

        ||

        student.prn
          .includes(searchTerm);


      const matchesStatus =
        statusFilter === 'all'
        ||
        student.status === statusFilter;


      return (
        matchesSearch &&
        matchesStatus
      );

    });


  renderTable(filtered);

}

</script>

</body>
</html>
